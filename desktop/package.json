{
  "name": "aitmeow",
  "version": "0.3.2",
  "private": true,
  "description": "AI Tmeow - Electron Desktop Client",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start": "npm run build:electron && electron .",
    "preview": "vite preview",
    "dist": "npm run build && npm run build:electron && electron-builder --win nsis --publish never",
    "dist:dir": "npm run build && npm run build:electron && electron-builder --win nsis --dir --publish never"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@types/node": "^20.19.42",
    "electron-updater": "^6.3.9",
    "file-saver": "^2.0.5",
    "immer": "^10.0.0",
    "jszip": "^3.10.1",
    "lightningcss-win32-x64-msvc": "^1.32.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.30.4",
    "sonner": "^2.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.aitmeow.app",
    "productName": "AitMeow",
    "directories": {
      "output": "../release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../target/release/aitmeow-server.exe",
        "to": "aitmeow-server.exe"
      },
      "resources/icon.png"
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "AitMeow-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "siciyuan404",
      "repo": "aitmeow"
    }
  }
}
